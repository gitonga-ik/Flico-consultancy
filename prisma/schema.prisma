generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

model books {
  ID           Int      @id @default(autoincrement())
  TITLE        String   @db.VarChar(150)
  DESCRIPTION  String   @db.VarChar(255)
  PRICE        Int
  FILE_PATH    String   @db.VarChar(200)
  SLUG         String   @unique(map: "books_pk") @db.VarChar(150)
  COVER_PATH   String   @db.VarChar(255)
  PREVIEW_PATH String[]
  orders       orders[]
}

model orders {
  ID                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  EMAIL             String               @db.VarChar(100)
  BOOK_ID           Int
  ORDER_STATUS      orders_order_status? @default(INACTIVE)
  PAYMENT           Boolean?             @default(false)
  CUST_DOC          String               @default("")
  DATE_CREATED      DateTime?            @default(now()) @db.Timestamp(0)
  DATE_LAST_UPDATED DateTime?            @default(now()) @db.Timestamp(6)
  books             books                @relation(fields: [BOOK_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_books_to_order")
  mpesaTransactions MpesaTransaction[]

  @@index([BOOK_ID], map: "fk_books_to_orders")
}

enum orders_order_status {
  ACTIVE
  INACTIVE
  CANCELLED
  CLOSED
}

enum MpesaTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

model MpesaTransaction {
  ID String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  ORDER_ID                String  @db.Uuid
  CONTACT                 String
  AMOUNT                  Decimal @db.Decimal(10, 2)
  TRANSACTION_DESCRIPTION String?

  MERCHANT_REQUEST_ID  String?
  CHECKOUT_REQUEST_ID  String? @unique
  MPESA_RECEIPT_NUMBER String? @unique

  STATUS             MpesaTransactionStatus @default(PENDING)
  RESULT_CODE        Int?
  RESULT_DESCRIPTION String?

  REQUEST_TIMESTAMP DateTime  @default(now())
  TRANSACTION_DATE  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     orders   @relation(fields: [ORDER_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_to_order")

  @@index([ORDER_ID])
  @@index([CONTACT])
  @@index([STATUS])
  @@map("mpesa_transactions")
}
